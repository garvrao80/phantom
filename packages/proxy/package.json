{
  "name": "@phantom/proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --exclude ./generated --exclude ../../data src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "test": "vitest run",
    "test:generated": "vitest run --config vitest.generated.config.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fastify/cors": "11",
    "ajv": "8",
    "ajv-formats": "3",
    "fastify": "5",
    "openai": "5"
  },
  "devDependencies": {
    "@types/node": "22",
    "tsx": "4",
    "typescript": "5",
    "vitest": "3"
  }
}
